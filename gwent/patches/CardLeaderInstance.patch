+      /**
+       * Whether this board shows the opponent's cards for View_3_Enemy: always outside a duel; in a duel only on the
+       * board of the leader's owner. The display changes no state, so nothing is sent or hashed (local only); on the
+       * other board vanilla would show the local player its own cards.
+       */
+      private function duelShowsEnemyHand() : Boolean
+      {
+         return DuelSession.active == null || owningPlayer == CardManager.PLAYER_1;
+      }
+
+      /**
+       * A leader choice in a duel (spec 9.6): the leader's owner decides (the local player through the vanilla dialog,
+       * the opponent through its D); both boards then run the vanilla handler with the same choice.
+       * This routing relies on ApplyLeaderAbility getting isAI false for both seats of a duel: PLAYER_1 is a
+       * HumanPlayerController and PLAYER_2 a NetOpponentController, and neither sets BasePlayerController.isAI. With
+       * isAI true vanilla would pick the resurrect target itself, skip Bin2_Pick1 and take the first weather card on
+       * one board only (test_decisions.py pins that neither controller sets isAI).
+       * @param kind LRES, LWEA, LBIN or LPICK.
+       * @param cards The card options (LRES, LBIN), or null.
+       * @param templates The template options (LWEA, LPICK), or null.
+       * @param text The vanilla dialog text.
+       */
+      private function duelDecide(kind:String, cards:Vector.<CardInstance>, templates:Vector.<int>, text:String) : void
+      {
+         this._duelChoiceKind = kind;
+         this._duelChoiceCards = cards;
+         this._duelChoiceTemplates = templates;
+         this._duelChoiceText = text;
+         DuelSession.active.decide(kind,DuelSession.active.seatOf(owningPlayer),DuelSession.active.ids.toNet(instanceId),this.duelShowChoice,this.duelApplyChoice,this.duelAutoChoice,this.duelFirstChoice);
+      }
+
+      /** The vanilla dialog for the open leader choice, answered through DuelSession.answer. */
+      private function duelShowChoice() : void
+      {
+         if(this._duelChoiceCards != null)
+         {
+            GwintGameFlowController.getInstance().mcChoiceDialog.showDialogCardInstances(this._duelChoiceCards,this.duelChoicePicked,null,this._duelChoiceText);
+         }
+         else
+         {
+            GwintGameFlowController.getInstance().mcChoiceDialog.showDialogCardTemplates(this._duelChoiceTemplates,this.duelChoicePicked,null,this._duelChoiceText);
+         }
+      }
+
+      private function duelChoicePicked(id:int) : void
+      {
+         DuelSession.active.answer(this._duelChoiceKind,this._duelChoiceCards != null ? DuelSession.active.netName(id) : "t" + id);
+      }
+
+      /**
+       * Runs the vanilla handler of the open leader choice.
+       * @return False if the choice is not one of the options (a desync).
+       */
+      private function duelApplyChoice(choice:String) : Boolean
+      {
+         var kind:String = this._duelChoiceKind;
+         var cards:Vector.<CardInstance> = this._duelChoiceCards;
+         var templates:Vector.<int> = this._duelChoiceTemplates;
+         var card:CardInstance = null;
+         var templateId:int = -1;
+         if(cards != null)
+         {
+            card = DuelSession.active.cardOfArg(choice);
+            if(card == null || cards.indexOf(card) < 0)
+            {
+               return false;
+            }
+         }
+         else
+         {
+            templateId = choice != null && choice.length > 1 && choice.charAt(0) == "t" ? int(choice.substr(1)) : -1;
+            if(templates == null || "t" + templateId != choice || templates.indexOf(templateId) < 0)
+            {
+               return false;
+            }
+         }
+         this._duelChoiceKind = null;
+         this._duelChoiceCards = null;
+         this._duelChoiceTemplates = null;
+         switch(kind)
+         {
+            case "LRES":
+               this.handleResurrectChoice(card.instanceId);
+               break;
+            case "LBIN":
+               this.handleBinChoice(card.instanceId);
+               break;
+            case "LWEA":
+               this.handleCardDrawChoice_Weather(templateId);
+               break;
+            case "LPICK":
+               this.handlePickChoice(templateId);
+               break;
+            default:
+               return false;
+         }
+         return true;
+      }
+
+      /** The first option of the open leader choice: the answer when the dialog goes away unanswered (R48). */
+      private function duelFirstChoice() : String
+      {
+         if(this._duelChoiceCards == null)
+         {
+            return "t" + this._duelChoiceTemplates[0];
+         }
+         return DuelSession.active.netName(this._duelChoiceCards[0].instanceId);
+      }
+
+      /**
+       * Autoplay's leader choice: the vanilla AI's where it has one (resurrect: getHigherOrLowerValueCardFromTargetGraveyard;
+       * weather: the first weather card), else the first option (bin, pick: the vanilla AI has no such choice).
+       */
+      private function duelAutoChoice() : String
+      {
+         if(this._duelChoiceCards == null)
+         {
+            return "t" + this._duelChoiceTemplates[0];
+         }
+         var card:CardInstance = this._duelChoiceCards[0];
+         if(this._duelChoiceKind == "LRES")
+         {
+            var pick:CardAndComboPoints = CardManager.getInstance().getHigherOrLowerValueCardFromTargetGraveyard(this._duelResTarget,true,true,false,this._duelResTarget != owningPlayer);
+            if(pick != null && pick.cardInstance != null && this._duelChoiceCards.indexOf(pick.cardInstance) >= 0)
+            {
+               card = pick.cardInstance;
+            }
+         }
+         return DuelSession.active.netName(card.instanceId);
+      }
