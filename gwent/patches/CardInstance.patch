+         DuelSession.active.decide("NUR",DuelSession.active.seatOf(this.listsPlayer),DuelSession.active.ids.toNet(this.instanceId),this.duelShowNurseChoice,this.duelApplyNurseChoice,this.duelAutoNurseChoice);
