+      /**
+       * Duel round start perks (spec 7.4): the Northern Realms draw of the last round's winner and the Skellige round 3
+       * resurrect, in seat order (seat A, then seat B) on both boards. Each perk shows its vanilla message and sound in
+       * that order, and all of them run together when the first of these messages shows (duelRunRoundStartPerks): a
+       * player may skip messages, so one callback per message would run them at different moments on the two boards.
+       */
+      private function duelPushRoundStartPerks() : void
+      {
+         var seat:int = 0;
+         var player:int = 0;
+         var faction:int = 0;
+         this._duelPerkPlayers.length = 0;
+         this._duelPerkKinds.length = 0;
+         for(seat = DuelIds.SEAT_A; seat <= DuelIds.SEAT_B; seat++)
+         {
+            player = DuelSession.active.playerOf(seat);
+            faction = this.cardManager.playerDeckDefinitions[player].getDeckFaction();
+            if(player == this.lastRoundWinner && faction == CardTemplate.FactionId_Northern_Kingdom)
+            {
+               this.duelPushPerk(player,DUEL_PERK_NORTH,"[[gwint_northern_ability_triggered]]","north_ability","gui_gwint_northern_realms_ability");
+            }
+            if(this.currentRound == 2 && faction == CardTemplate.FactionId_Skellige)
+            {
+               this.duelPushPerk(player,DUEL_PERK_SKELLIGE,player == CardManager.PLAYER_1 ? "[[gwint_skel_ability_player_triggered]]" : "[[gwint_skel_ability_ai_triggered]]","skel_ability","gui_gwint_skellige_ability");
+            }
+         }
+      }
+      
+      /**
+       * Duel: shows one round start perk's message and sound; the first message carries the callback that runs them all.
+       */
+      private function duelPushPerk(player:int, kind:int, message:String, image:String, sound:String) : void
+      {
+         var first:Boolean = this._duelPerkPlayers.length == 0;
+         // filled before PushMessage: it runs the callback at once when no other message is showing
+         this._duelPerkPlayers.push(player);
+         this._duelPerkKinds.push(kind);
+         this.mcMessageQueue.PushMessage(message,image,first ? this.duelRunRoundStartPerks : null,null);
+         GwintGameMenu.mSingleton.playSound(sound);
+      }
+      
+      /**
+       * Duel: runs this round start's perks in seat order (the draw and the resurrects start their card moves; the
+       * landing effects then run in canonical order through DuelSession.deferEffect). Logs DUEL PERK <north|skellige>
+       * seat=<A|B> for each.
+       */
+      private function duelRunRoundStartPerks() : void
+      {
+         var i:int = 0;
+         var player:int = 0;
+         if(DuelSession.active == null || DuelSession.active.ended)
+         {
+            return;
+         }
+         for(i = 0; i < this._duelPerkPlayers.length; i++)
+         {
+            player = this._duelPerkPlayers[i];
+            DuelSession.active.log("DUEL PERK " + (this._duelPerkKinds[i] == DUEL_PERK_NORTH ? "north" : "skellige") + " seat=" + (DuelSession.active.seatOf(player) == DuelIds.SEAT_A ? "A" : "B"));
+            if(this._duelPerkKinds[i] == DUEL_PERK_NORTH)
+            {
+               this.cardManager.drawCard(player);
+            }
+            else
+            {
+               this.cardManager.ressurectFromGraveyard(player,2);
+            }
+         }
+         this._duelPerkPlayers.length = 0;
+         this._duelPerkKinds.length = 0;
+      }
